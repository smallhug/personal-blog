---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 · 404 · smallhug">
  <div class="not-found-container glass-card">
    <div class="code-badge">404</div>
    <h1 class="title">迷失在数字绿洲深处</h1>
    <p class="desc">您所访问的页面不存在或已被归档迁移。</p>
    <a href="/" class="btn-primary">返回首页</a>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    text-align: center;
    padding: 5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    margin: 2rem auto;
    max-width: 600px;
  }
  .code-badge {
    font-size: 4rem;
    font-weight: 800;
    color: var(--color-accent-1);
    font-family: var(--font-serif);
    line-height: 1;
  }
  .title {
    font-size: 1.8rem;
    color: var(--text-primary);
  }
  .desc {
    color: var(--text-muted);
    font-size: 1.05rem;
  }
</style>
