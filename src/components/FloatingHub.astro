---
// FloatingHub.astro: 原生 SVG 滚动进度与回到顶部
---

<div
  id="floating-hub"
  class="hub-container"
  title="返回顶部"
  role="button"
  aria-label="Back to top"
>
  <svg class="progress-ring" width="48" height="48">
    <circle
      class="ring-track"
      stroke="var(--glass-border)"
      stroke-width="2.5"
      fill="transparent"
      r="20"
      cx="24"
      cy="24"
    />
    <circle
      id="ring-indicator"
      class="ring-indicator"
      stroke="var(--color-accent-1)"
      stroke-width="2.5"
      stroke-linecap="round"
      fill="transparent"
      r="20"
      cx="24"
      cy="24"
    />
  </svg>

  <div class="center-widget">
    <span id="hub-text" class="progress-text">0<span class="percent-symbol">%</span></span>
    <svg id="hub-arrow" class="arrow-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-1)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m18 15-6-6-6 6"></path>
    </svg>
  </div>
</div>

<style>
  .hub-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 90;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.9);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--glass-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .hub-container.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .hub-container:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
  }

  .progress-ring {
    position: absolute;
    top: 0;
    left: 0;
    transform: rotate(-90deg);
  }

  .ring-indicator {
    stroke-dasharray: 125.66;
    stroke-dashoffset: 125.66;
    transition: stroke-dashoffset 0.1s linear;
  }

  .center-widget {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .progress-text {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-primary);
    display: flex;
    align-items: center;
  }

  .percent-symbol {
    font-size: 0.55rem;
  }

  .arrow-icon {
    display: none;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent-1);
  }

  .hub-container:hover .progress-text {
    display: none;
  }

  .hub-container:hover .arrow-icon {
    display: block;
  }
</style>

<script>
  function setupFloatingHub() {
    const hub = document.getElementById('floating-hub');
    const indicator = document.getElementById('ring-indicator');
    const text = document.getElementById('hub-text');
    if (!hub || !indicator || !text) return;

    const circumference = 2 * Math.PI * 20; // 125.66

    const handleScroll = () => {
      const scrollHeight = document.documentElement.scrollHeight;
      const clientHeight = document.documentElement.clientHeight;
      const totalHeight = scrollHeight - clientHeight;

      const progress = totalHeight > 0 ? Math.min(Math.max((window.scrollY / totalHeight) * 100, 0), 100) : 0;
      const offset = circumference - (progress / 100) * circumference;

      indicator.style.strokeDashoffset = `${offset}`;
      text.innerHTML = `${Math.round(progress)}<span class="percent-symbol">%</span>`;

      if (window.scrollY > 200) {
        hub.classList.add('visible');
      } else {
        hub.classList.remove('visible');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    hub.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloatingHub);
  } else {
    setupFloatingHub();
  }
</script>
