---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TOC from '../../components/TOC.astro';
import CodeCopyButton from '../../components/CodeCopyButton.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import BusuanziCounter from '../../components/BusuanziCounter.astro';
import { formatToChineseDateTime } from '../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => post.data.status === 'PUBLISHED')
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const plainText = (post.body || '').replace(/[#*`~\[\]\(\)\-\r\n\s|]+/g, '');
const readingTime = Math.max(1, Math.ceil(plainText.length / 200));
---

<BaseLayout
  title={`${post.data.title} · smallhug的数字空间`}
  description={post.data.summary || post.data.excerpt || post.data.title}
  article={true}
>
  <div class="post-container">
    <!-- 面包屑与文章头图区 -->
    <header class="post-header">
      <a href={import.meta.env.BASE_URL} class="back-btn">
        <svg class="back-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <span>返回文章列表</span>
      </a>

      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-meta">
        <span class="meta-item">
          <svg class="meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="3" y1="10" y2="10"></line>
          </svg>
          {formatToChineseDateTime(post.data.date)}
        </span>
        <span class="dot">·</span>
        <span class="meta-item">
          <svg class="meta-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          约 {readingTime} 分钟阅读
        </span>
        <span class="dot">·</span>
        <span class="meta-item">
          <BusuanziCounter type="page" />
        </span>
      </div>

      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <span class="badge">#{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- 黄金标准排版：左/中正文主轴，右侧吸顶目录 -->
    <div class="article-layout">
      <!-- 主正文区域 -->
      <article class="article-main">
        <div class="article-content glass-card" id="article-content">
          <Content />
        </div>

        <!-- 评论系统 (Giscus) -->
        <GiscusComments />
      </article>

      <!-- 右侧文章大纲目录 -->
      <aside class="toc-sidebar">
        <TOC headings={headings} />
      </aside>
    </div>

    <!-- 复制代码悬浮按钮 (纯原生轻量脚本) -->
    <CodeCopyButton />
  </div>
</BaseLayout>

<style>
  .post-container {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
  }

  .post-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--glass-border);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .back-btn {
    align-self: flex-start;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .back-btn:hover {
    color: var(--color-accent-1);
    background: var(--color-accent-light);
    transform: translateX(-3px);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 2.35rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    letter-spacing: -0.5px;
    margin: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* 黄金标准主内容与侧边栏两栏网格 */
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 2.25rem;
    align-items: start;
  }

  .article-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .toc-sidebar {
    position: sticky;
    top: 90px;
    align-self: start;
  }

  /* 正文排版与 Markdown 渲染美化 */
  .article-content {
    padding: 2.5rem 3rem;
    line-height: 1.85;
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  :global(.article-content h1),
  :global(.article-content h2),
  :global(.article-content h3),
  :global(.article-content h4) {
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 700;
    scroll-margin-top: 100px;
    letter-spacing: -0.3px;
  }

  :global(.article-content h1) {
    font-size: 1.85rem;
    border-bottom: 1px solid var(--glass-border);
    padding-bottom: 0.5rem;
  }

  :global(.article-content h2) {
    font-size: 1.45rem;
    border-left: 4px solid var(--color-accent-1);
    padding-left: 0.75rem;
  }

  :global(.article-content h3) {
    font-size: 1.2rem;
  }

  :global(.article-content p) {
    margin-bottom: 1.45rem;
  }

  :global(.article-content ul),
  :global(.article-content ol) {
    margin-bottom: 1.45rem;
    padding-left: 1.75rem;
  }

  :global(.article-content li) {
    margin-bottom: 0.45rem;
  }

  :global(.article-content blockquote) {
    border-left: 4px solid var(--color-accent-1);
    background: var(--color-accent-light);
    padding: 1rem 1.45rem;
    margin: 1.5rem 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  :global(.article-content hr) {
    border: none;
    border-top: 1px solid var(--glass-border);
    margin: 2.5rem 0;
  }

  /* 代码高亮块容器 */
  :global(.article-content pre) {
    background: var(--bg-tertiary) !important;
    border: 1px solid var(--glass-border) !important;
    border-radius: var(--radius-md) !important;
    padding: 1.25rem 1.5rem !important;
    overflow-x: auto;
    margin: 1.75rem 0 !important;
    font-size: 0.9rem;
    font-family: var(--font-mono) !important;
    position: relative;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }

  :global(.article-content code) {
    font-family: var(--font-mono);
    background: var(--bg-tertiary);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    font-size: 0.88em;
    color: var(--color-accent-1);
  }

  :global(.article-content pre code) {
    background: transparent !important;
    padding: 0 !important;
    color: inherit;
    font-size: 0.9em;
  }

  /* 图片与多媒体 */
  :global(.article-content img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 1.75rem auto;
    display: block;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  /* 数据表格美化 */
  :global(.article-content table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    overflow-x: auto;
    display: block;
    border-radius: var(--radius-sm);
    border: 1px solid var(--glass-border);
  }

  :global(.article-content th),
  :global(.article-content td) {
    border: 1px solid var(--glass-border);
    padding: 0.75rem 1.15rem;
    text-align: left;
    font-size: 0.92rem;
  }

  :global(.article-content th) {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-weight: 600;
  }

  :global(.article-content tr:nth-child(even)) {
    background: rgba(125, 125, 125, 0.02);
  }

  /* 响应式平板与移动端 */
  @media (max-width: 1024px) {
    .article-layout {
      grid-template-columns: 1fr;
    }

    .toc-sidebar {
      display: none;
    }

    .article-content {
      padding: 2rem 1.75rem;
    }

    .post-title {
      font-size: 1.95rem;
    }
  }

  @media (max-width: 640px) {
    .article-content {
      padding: 1.5rem 1.2rem;
      font-size: 1rem;
    }

    .post-title {
      font-size: 1.65rem;
    }
  }
</style>
